# Trustwright environment — copy to .env.local and fill in. NEVER commit real values.
#
# ─── Client (safe to expose; bundled into the SPA) ───────────────────────────
# The Supabase publishable/anon key is designed to be public, and is ONLY safe
# because every table has Row-Level Security enabled (see supabase/migrations).
# It can write scorecards + leads under RLS and nothing else.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# The Cloudflare Worker origin that proxies the detector (Trust the Machine level).
# The browser never calls the detector directly and never holds its key.
VITE_WORKER_ORIGIN=https://range-api.deepblocker.ai

# ─── Worker secrets (set via `wrangler secret put`, NEVER in this file) ───────
# SUPABASE_SERVICE_ROLE_KEY   — privileged writes; Worker-only
# DEEPFAKE_API_KEY            — detector auth (X-API-Key); Worker-only
# DEEPFAKE_ROUTER_URL         — the detector endpoint (Worker-only)
# RESEND_API_KEY              — optional: send the report email (Resend)
# RESEND_FROM                 — optional: verified sender, e.g. "Trustwright <reports@deepblocker.ai>"
# POSTMARK_SERVER_API_KEY     — optional: badge-health alerts (Postmark server token)
# ALERT_EMAIL                 — optional: where badge-health alerts go (operator inbox)
# POSTMARK_FROM               — optional: verified sender, defaults to "Trustwright <shield@deepblocker.ai>"
